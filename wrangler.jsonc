{
  "name": "alfa-market-data",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "ALFA_KV"
    }
  ]
}
